# Local prototype settings
# Leave PGLITE_MEMORY unset for normal local development.
# Set PGLITE_MEMORY=1 only for temporary in-memory preview/testing.
# PGLITE_MEMORY=1

# Optional private AI assistant. Leave these unset to use the safe local
# metadata summary. Do not point this at a public AI service for real
# departmental documents without written approval.
# PRIVATE_AI_BASE_URL=http://127.0.0.1:11434
# PRIVATE_AI_MODEL=qwen2.5:7b
# PRIVATE_AI_API_KEY=

# First production startup: set a private, one-time admin password before the
# empty production database is initialized. Production does not seed public
# demo accounts or sample Dak data.
# INITIAL_ADMIN_PASSWORD=

# OCR for scanned image documents (JPG/PNG uploads).
# The engine and its language data run fully inside Node.js from installed
# packages (tesseract.js + @tesseract.js-data/eng + @tesseract.js-data/urd),
# so no external/cloud service sees departmental documents and OCR keeps
# working on an offline office LAN after `npm install`.
# DPO_OCR_ENABLED=1
# DPO_OCR_LANGS=eng+urd
# Optional: use files you supply yourself instead of the npm language data.
# The directory must contain <lang>.traineddata.gz for every DPO_OCR_LANGS code.
# DPO_OCR_LANG_PATH=/secure/path/to/traineddata

# Managed PostgreSQL mode. Leave DATABASE_URL unset to keep using the
# embedded PGlite prototype. When set, the app connects with a pooled
# node-postgres (pg) adapter against a PostgreSQL 16+ server and the same
# schema/SQL runs unchanged; PGlite tar snapshots are disabled because the
# server manages its own durability.
# DATABASE_URL=postgresql://dpo_app:PASSWORD@127.0.0.1:5432/dpo_dak
# DB_POOL_MAX=10
# Add ?sslmode=require when the server needs TLS (e.g. a managed cloud DB).

# In PostgreSQL mode the backup ZIP carries private document files only;
# back up the database with `npm run pg:backup` (logical archive, restore via
# `npm run pg:restore -- backups/pg-<stamp>.zip`) or department-approved
# pg_dump/WAL/PITR procedures. See DEPLOYMENT.md for the full runbook.
