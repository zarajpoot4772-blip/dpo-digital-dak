# /etc/dpo-dak.env — production environment for the dpo-dak systemd service.
# Protect this file: sudo chown root:dpo /etc/dpo-dak.env && sudo chmod 640 /etc/dpo-dak.env

# Managed PostgreSQL connection (required for production).
# Use scram-sha- auth over the LAN; add ?sslmode=require when TLS is enabled
# between the app host and the database.
DATABASE_URL=postgresql://dpo_app:CHANGE_ME_STRONG_PASSWORD@127.0.0.1:5432/dpo_dak

# Connection pool size (default 10; raise only if monitoring shows contention).
DB_POOL_MAX=10

# Private document storage outside the deploy directory (survives redeploys).
DPO_RUNTIME_ROOT=/var/lib/dpo-dak

# ONLY for the very first start on an empty production database: after the
# first login and password change, remove this line from the file.
INITIAL_ADMIN_PASSWORD=CHANGE_ME_ONE_TIME_ADMIN_PASSWORD
